<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anitta Nail Spa Beauty</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Georgia', serif;
            color: #fff;
        }
        /* Fondo de video */
        video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            z-index: -1;
        }
        .container {
            text-align: center;
            position: relative;
            top: 40%;
            transform: translateY(-50%);
        }
        /* Título animado */
        h1 {
            font-style: italic;
            font-size: 3em;
            animation: slideIn 3s ease-in-out infinite alternate;
        }
        @keyframes slideIn {
            0% {
                letter-spacing: 2px;
                opacity: 0.6;
            }
            100% {
                letter-spacing: 6px;
                opacity: 1;
            }
        }
        /* Botones */
        .button {
            display: block;
            background-color: #fff;
            color: #800020;
            text-decoration: none;
            padding: 15px 30px;
            margin: 10px auto;
            border-radius: 25px;
            font-size: 18px;
            font-weight: bold;
            font-style: italic;
            width: 200px;
            transition: background 0.3s, color 0.3s, transform 0.2s;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }
        .button:hover {
            background-color: #800020;
            color: #fff;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <!-- Fondo de video -->
    <video autoplay muted loop>
        <source src="tu-video.mp4" type="video/mp4">
        Tu navegador no soporta el video de fondo.
    </video>
    
    <div class="container">
        <h1>Anitta Nail Spa Beauty</h1>
        <a href="#" class="button" onclick="playSound()">Agenda tu cita</a>
        <a href="#" class="button" onclick="playSound()">Galería</a>
        <a href="#" class="button" onclick="playSound()">Encuéntranos</a>
    </div>

    <!-- Sonido al presionar botones -->
    <audio id="clickSound" src="https://www.soundjay.com/button/beep-07.wav" preload="auto"></audio>
    <script>
        function playSound() {
            var sound = document.getElementById("clickSound");
            sound.currentTime = 0;
            sound.play();
        }
    </script>
</body>
</html>
